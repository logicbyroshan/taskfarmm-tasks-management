# ==============================================================================
#  TaskFlixx Environment Configuration Template
#  Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Django Secret Key (Generate a new secure key for production)
SECRET_KEY=django-insecure-taskflixx-change-me-in-production-secure-random-key-12345

# Debug Mode (Set to False in production)
DEBUG=True

# Allowed Hosts (Comma-separated hostnames/domains)
ALLOWED_HOSTS=127.0.0.1,localhost,taskflix.rkdapp.site

# Database Configuration (Optional: Defaults to SQLite if unset)
# Option A: Standard Connection URI (PostgreSQL or MySQL)
# DATABASE_URL=mysql://root:password@localhost:3306/taskflixx_db
# DATABASE_URL=postgres://username:password@localhost:5432/taskflixx_db
#
# Option B: Explicit MySQL Connection Fields
# DB_ENGINE=mysql
# DB_NAME=taskflixx_db
# DB_USER=root
# DB_PASSWORD=your_mysql_password
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Email Service Configuration (Optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=TaskFlixx <noreply@taskflixx.com>
